# Copy this to .env (same filename docker-compose.yml and the gateway
# container both read) before running `npm run docker:up`.
#
# This is almost identical to .env.example - the one difference is
# MONGO_URI/REDIS_URL below, since docker-compose.yml overrides both of
# those for the gateway container regardless of what's set here (it points
# them at the "mongo"/"redis" service containers instead - see the compose
# file's comments). The values below are only what the rest of the stack -
# and anything you run outside Docker, like `npm run create-key` on your
# host - actually needs.

PORT=3000
# Only used if you run the gateway OUTSIDE Docker. Inside Docker,
# docker-compose.yml always overrides this to mongodb://mongo:27017/llm-gateway.
MONGO_URI=mongodb://localhost:27017/llm-gateway

# Primary provider - required (it's in PROVIDER_ORDER below).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallback provider - required (it's in PROVIDER_ORDER below).
# Also required for semantic caching's embeddings (see below), regardless of PROVIDER_ORDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Not currently used - only required if you add "openrouter" into PROVIDER_ORDER below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Only used if you run the gateway OUTSIDE Docker. Inside Docker,
# docker-compose.yml always overrides this to redis://redis:6379.
REDIS_URL=redis://localhost:6379

CACHE_TTL_SECONDS=86400
PROVIDER_ORDER=groq,gemini
PROVIDER_TIMEOUT_MS=15000
MAX_RETRIES=2
STREAM_IDLE_TIMEOUT_MS=10000

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
SEMANTIC_CACHE_ENABLED=true
SIMILARITY_THRESHOLD=0.90
SEMANTIC_JUDGE_ENABLED=true
JUDGE_TIMEOUT_MS=3000
JUDGE_SKIP_ABOVE=0.97

# Generate a real random value - don't ship this default.
ADMIN_API_KEY=
DASHBOARD_ORIGIN=http://localhost:5173

# Docker-only: the URL the dashboard's built JS will call the gateway at.
# Read by docker-compose.yml itself (as a build arg for the dashboard
# image), not by the gateway container - must be a URL your BROWSER can
# reach, so the host-mapped port (matching PORT/the gateway's "ports:"
# mapping above), never the "gateway" service name.
VITE_API_URL=http://localhost:3000

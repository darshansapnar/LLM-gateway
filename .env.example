PORT=3000
MONGO_URI=
# Primary provider - required (it's in PROVIDER_ORDER below).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallback provider - required (it's in PROVIDER_ORDER below).
# Also required for semantic caching's embeddings (see below), regardless of PROVIDER_ORDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Not currently used - only required if you add "openrouter" into PROVIDER_ORDER below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
# Which providers to try, in order. Each name's env vars above become
# required only while that name is listed here (see src/config/env.js).
PROVIDER_ORDER=groq,gemini
PROVIDER_TIMEOUT_MS=15000
MAX_RETRIES=2
# How long (ms) a stream can go with no new chunk before we give up on it.
STREAM_IDLE_TIMEOUT_MS=10000
# Semantic caching: match prompts by meaning, not just exact text, using
# Gemini embeddings + a Redis vector index. Requires GEMINI_API_KEY above.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
SEMANTIC_CACHE_ENABLED=true
# Deliberately low - this is just the "plausible candidate" bar. The antonym
# guard + LLM judge in cacheVerifier.service.js do the real separation.
SIMILARITY_THRESHOLD=0.90
# Asks the primary provider "do these mean the same thing?" before trusting
# a semantic candidate. Safer but adds one small provider call per candidate.
SEMANTIC_JUDGE_ENABLED=true
JUDGE_TIMEOUT_MS=3000
# A candidate this similar (and with no entity difference - different
# country/language/framework/product) skips the judge and is accepted outright.
JUDGE_SKIP_ABOVE=0.97
# Dashboard (Stage 7): a single shared admin secret, sent as the
# "x-admin-key" header, that unlocks /v1/admin/* (logs, stats, API key
# management). Generate a real random value - don't ship this default.
ADMIN_API_KEY=
# Which origin the dashboard's browser is allowed to call the API from (CORS).
DASHBOARD_ORIGIN=http://localhost:5173

{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "create-key": "node scripts/createApiKey.js",
    "eval-cache": "node scripts/evalSemanticCache.js",
    "eval-pii": "node scripts/evalPii.js",
    "clear-semantic-cache": "node scripts/clearSemanticCache.js",
    "install:dashboard": "npm --prefix dashboard install",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:dashboard": "npm --prefix dashboard run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "eslint src/ tests/ scripts/",
    "test": "node --test --test-concurrency=1 tests/unit/**/*.test.js tests/integration/**/*.test.js tests/pii.route.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/**/*.test.js tests/pii.route.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/unit/**/*.test.js tests/integration/**/*.test.js tests/pii.route.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14"
  }
}
